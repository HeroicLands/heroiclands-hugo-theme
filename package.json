{
  "name": "@heroiclands/hugo-theme",
  "version": "0.2.0",
  "description": "Shared Hugo theme for the Heroic Lands projects",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "Tom Rodriguez",
    "email": "toasty@heroiclands.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeroicLands/heroiclands-hugo-theme.git"
  },
  "bugs": {
    "url": "https://github.com/HeroicLands/heroiclands-hugo-theme/issues"
  },
  "homepage": "https://github.com/HeroicLands/heroiclands-hugo-theme#readme",
  "keywords": [
    "hugo",
    "hugo-theme",
    "heroic-lands",
    "sohl"
  ],
  "files": [
    "layouts",
    "static",
    "data",
    "theme.toml",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "npm run lint:labels && npm run lint:banners",
    "lint:labels": "node utils/check-labels.mjs",
    "lint:banners": "node utils/check-banners.mjs",
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main",
    "changeset:version": "changeset version && npm install --package-lock-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "yaml": "^2.9.0"
  }
}
